    "test:pwa": "npm run build && npm run test:browser",
    "icons": "node scripts/generate-icons.ts",
    "test:browser": "playwright test",
    "test:vercel": "npm run build && node --test tests/vercel.node.ts",
    "api:generate": "node scripts/export-api-contract.ts && oxfmt openapi/cure.json && orval --config orval.config.ts"
