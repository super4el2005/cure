# Frontend and TanStack Start server: copy these from your Convex deployment.
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Set the following in the Convex deployment environment, not in public frontend variables:
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<random secret, at least 32 characters>
# GOOGLE_CLIENT_ID=<OAuth client ID from Google Cloud>
# GOOGLE_CLIENT_SECRET=<OAuth client secret from Google Cloud>

# GigaChat runs in the TanStack Start server (local shell / Vercel runtime env).
# Never put these in public Rsbuild variables or the Convex auth environment.
# GIGACHAT_CREDENTIALS=<Authorization Key from GigaChat Studio, without Basic prefix>
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# Optional: PEM CA bundle with real newlines from the official certificate instructions.
# GIGACHAT_CA_CERT=<PEM bundle>

# Allowed full HTTPS base URLs for user-supplied OpenAI-compatible providers.
# AI_ALLOWED_BASE_URLS=https://my-gateway.example/v1

# Medical catalog: TanStack Start server only (local .env.local / Vercel runtime).
# Register API credentials at https://icd.who.int/icdapi
# WHO_ICD_CLIENT_ID=<WHO ICD API client ID>
# WHO_ICD_CLIENT_SECRET=<WHO ICD API client secret>
# Optional NCBI E-utilities API key; PubMed also works without it.
# NCBI_API_KEY=<NCBI API key>

# Optional Sentry: see docs/observability.md. Browser DSN is public; auth token is build-only.
# SENTRY_DSN=https://public-key@your-sentry-host/project-id
# Optional override for browser only; defaults to SENTRY_DSN at build time.
# PUBLIC_SENTRY_DSN=https://public-key@your-sentry-host/project-id
# SENTRY_ORG=your-org
# SENTRY_PROJECT=cure
# SENTRY_AUTH_TOKEN=<private sourcemap upload token>
# SENTRY_RELEASE=<same release at build and runtime outside Vercel>

# Vercel integration manages these destinations; the application SDK uses SENTRY_DSN.
# SENTRY_OTLP_TRACES_URL=<integration-provided OTLP traces endpoint>
# SENTRY_PUBLIC_KEY=<public DSN key; not a private auth token>
# SENTRY_VERCEL_LOG_DRAIN_URL=<integration-provided Vercel log drain endpoint>
